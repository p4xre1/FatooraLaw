# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/
#
# This app is a static, client-only SPA — no server the app itself
# controls — that talks directly to Supabase for auth and data, plus
# consent-gated Google Analytics, Cloudflare Web Analytics and data: URIs for user-uploaded logos — fonts are self-hosted, so there is no external font/style origin. The CSP below is
# scoped to exactly that. Tighten/loosen only if you actually add a new
# external dependency (a new API, an embed, an analytics script, etc.).
#
# connect-src includes https://*.supabase.co: without it, every
# supabase-js call (auth, the /admin CMS's posts queries, everything in
# src/lib/supabase.ts) is silently blocked by the browser at the network
# layer — the request never leaves the page. This is *required*, not
# optional hardening, for anything using Supabase to actually work.
#
# Optional — only if you enable Cloudflare Turnstile on the admin login
# form (VITE_TURNSTILE_SITE_KEY, see src/admin/lib/turnstile.ts): add
# " https://challenges.cloudflare.com" to script-src, and add a
# "frame-src https://challenges.cloudflare.com;" directive. Left out by
# default so the CSP stays as tight as possible until you actually turn
# Turnstile on.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), gyroscope=(), magnetometer=(), interest-cohort=(), accelerometer=(), autoplay=(), display-capture=(), midi=(), screen-wake-lock=(), xr-spatial-tracking=(), clipboard-write=(), fullscreen=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-XSS-Protection: 0
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://*.supabase.co https://*.google-analytics.com https://www.google-analytics.com https://www.googletagmanager.com https://cloudflareinsights.com https://static.cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; upgrade-insecure-requests

/admin/*
  X-Robots-Tag: noindex, nofollow

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# --------------------------------------------------------------------------
# Language trees: the `hreflang` tags in every document are the primary signal
# (see src/lib/locales.ts); Content-Language is the response-level signal for
# crawlers and proxies that read headers without parsing the HTML. The
# unprefixed French pages need no header — French is the document default.
# --------------------------------------------------------------------------
/ar
  Content-Language: ar-MA
/ar/*
  Content-Language: ar-MA
/en
  Content-Language: en
/en/*
  Content-Language: en

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# --------------------------------------------------------------------------
# Private screens: never indexed. The same routes are emitted as `noindex`
# documents by the build (see vite.config.ts → figma-seo-routes, which reads
# src/lib/routes.ts) and rendered with a noindex head by the app; this header
# is the third, script-independent layer. Kept in sync with src/lib/routes.ts.
# --------------------------------------------------------------------------
/login*
  X-Robots-Tag: noindex, nofollow, noarchive
/signup*
  X-Robots-Tag: noindex, nofollow, noarchive
/forgot-password*
  X-Robots-Tag: noindex, nofollow, noarchive
