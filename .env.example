# Copy to `.env` (or `.env.local`) and fill both lines in, then restart Vite.
# VITE_SUPABASE_URL is the project's API URL — https://<project-ref>.supabase.co
# — not the dashboard link (https://supabase.com/dashboard/...).
# VITE_SUPABASE_ANON_KEY is the public anon/publishable key of the *same*
# project. Never use a service-role/sb_secret_ key here: VITE_* values ship in
# the browser bundle, and the app refuses secret keys instead of signing with
# them (see SECURITY.md and src/lib/supabaseConfig.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional CMS CAPTCHA. Also requires matching Supabase CAPTCHA settings and
# the Turnstile script/frame origins in public/_headers (see SECURITY.md).
VITE_TURNSTILE_SITE_KEY=
