# Public Supabase project URL and anon/publishable key. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional CMS CAPTCHA. Also requires matching Supabase CAPTCHA settings and
# the Turnstile script/frame origins in public/_headers (see SECURITY.md).
VITE_TURNSTILE_SITE_KEY=
