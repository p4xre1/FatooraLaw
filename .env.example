# ---------------------------------------------------------------------------
# Fatorati — public browser configuration
# ---------------------------------------------------------------------------
# Copy to `.env` (or `.env.local`, which wins and is git-ignored) and fill both
# lines in, then restart Vite: these values are read once, at start/build time.
#
#   cp .env.example .env
#
# THE #1 RULE: `VITE_*` values are inlined into the browser bundle *at build
# time*. Setting them in your local `.env` has no effect on a site that was
# built somewhere else (Cloudflare Pages, CI). A deployed site that reports
# "Configuration Supabase requise" was built without them — set them in the
# build environment too. See docs/ENVIRONMENT.md.
#
# VITE_SUPABASE_URL is the project's API URL — https://<project-ref>.supabase.co
# — not the dashboard link (https://supabase.com/dashboard/...).
# VITE_SUPABASE_ANON_KEY is the public anon/publishable key of the *same*
# project. Never use a service-role/sb_secret_ key here: VITE_* values ship in
# the browser bundle, and the app refuses secret keys instead of signing with
# them (see SECURITY.md and src/lib/supabaseConfig.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Note: `.env.production` is committed with this project's *public* pair, so
# production builds (including Cloudflare Pages) work with no dashboard
# variables set. A value set here, in `.env.local`, or in the build
# environment overrides the committed one — that's how you point a build at a
# different Supabase project without touching git.

# Optional CMS CAPTCHA. Also requires matching Supabase CAPTCHA settings and
# the Turnstile script/frame origins in public/_headers (see SECURITY.md).
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Build controls (server-side only — never expose these to the browser)
# ---------------------------------------------------------------------------
# ALLOW_UNCONFIGURED_SUPABASE=1  build even though Supabase is unusable (e.g.
#                                to preview the marketing pages). By default a
#                                Cloudflare Pages build fails instead of
#                                shipping a site with no authentication.
# REQUIRE_SUPABASE_ENV=1         demand a usable pair in ANY CI build.
